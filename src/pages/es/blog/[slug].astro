---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import ElectoralMap from '../../../components/ElectoralMap.astro';
import { useTranslations, getBlogPath } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { slug: 'reflexiones-elecciones-colombia-2026' } },
  ];
}

const lang: Lang = 'es';
const { slug } = Astro.params;
const t = useTranslations(lang);
const post = t.blog.posts.find((p) => p.slug === slug)!;
const currentPath = getBlogPath(lang, slug!);
---

<BaseLayout title={`${post.title} — Global Bridge Consultancy`} description={post.summary} lang={lang}>
  <Navbar lang={lang} currentPath={currentPath} />
  <main class="article-page">
    <article class="article">
      <header class="article__header">
        <div class="container article__header-inner">
          <a href={getBlogPath(lang)} class="article__back">&larr; {t.blog.backToBlog}</a>
          <span class="article__category">{post.category}</span>
          <h1 class="article__title">{post.title}</h1>
          {post.subtitle && <p class="article__subtitle">{post.subtitle}</p>}
          <time class="article__date" datetime={post.isoDate}>{post.date}</time>
        </div>
      </header>

      <div class="container article__content">
        {post.sections.map((section) => {
          if (section.type === 'heading') {
            return <h2 class="article__heading">{section.title}</h2>;
          }
          if (section.type === 'callout') {
            return (
              <div class="article__callout">
                <p set:html={section.content as string} />
              </div>
            );
          }
          if (section.type === 'pullquote') {
            return (
              <blockquote class="pull-quote">
                <p>{section.content as string}</p>
              </blockquote>
            );
          }
          if (section.type === 'map') {
            return <ElectoralMap caption={section.caption} />;
          }
          return (section.content as string[]).map((p: string) => (
            <p class="article__paragraph" set:html={p} />
          ));
        })}

        <aside class="article__byline">
          <p class="article__byline-author">{post.author}</p>
          {post.editor && <p class="article__byline-editor">{t.blog.editionLabel}: {post.editor}</p>}
        </aside>

        <hr class="article__separator" />
        <aside class="article__data-note">
          <h3 class="article__data-note-title">{t.blog.dataNote}</h3>
          {post.dataNote.items.map((item) => (
            <p class="article__data-note-item">
              <strong>{item.label}:</strong> {item.text}
            </p>
          ))}
        </aside>
      </div>
    </article>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .article-page {
    padding-top: 72px;
  }

  .article__header {
    padding: var(--space-2xl) 0 var(--space-xl);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-2xl);
  }

  .article__header-inner {
    max-width: 960px;
  }

  .article__back {
    display: inline-block;
    font-size: var(--fs-sm);
    color: var(--color-accent);
    font-weight: var(--fw-medium);
    margin-bottom: var(--space-md);
    transition: color var(--transition-fast);
  }

  .article__back:hover {
    color: var(--color-accent-dark);
  }

  .article__category {
    display: block;
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-sm);
  }

  .article__title {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: var(--fw-bold);
    line-height: 1.2;
    margin-bottom: var(--space-md);
    max-width: 720px;
  }

  .article__subtitle {
    font-size: var(--fs-xl);
    color: var(--color-text);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    margin-bottom: var(--space-md);
  }

  .article__date {
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
  }

  /* Article content — single column, comfortable reading width */
  .article__content {
    max-width: 960px;
    padding-bottom: var(--space-3xl);
  }

  .article__heading {
    font-size: var(--fs-xl);
    font-weight: var(--fw-bold);
    color: var(--color-accent);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
    line-height: 1.3;
  }

  .article__paragraph {
    font-size: var(--fs-base);
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
  }

  .article__paragraph :global(strong) {
    color: var(--color-text);
    font-weight: var(--fw-semibold);
  }

  .article__paragraph :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .article__paragraph :global(a:hover) {
    color: var(--color-accent-dark);
  }

  /* Callout box */
  .article__callout {
    background: var(--color-section-alt);
    border-left: 4px solid var(--color-accent);
    padding: var(--space-lg);
    border-radius: 0 var(--border-radius) var(--border-radius) 0;
    margin: var(--space-lg) 0;
  }

  .article__callout p {
    font-size: var(--fs-base);
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .article__callout :global(a) {
    color: var(--color-accent);
    font-weight: var(--fw-semibold);
    text-decoration: underline;
  }

  /* Pull quotes — inline highlight cards */
  .pull-quote {
    background: var(--color-section-alt);
    border-left: 4px solid var(--color-accent);
    border-radius: 0 var(--border-radius-lg) var(--border-radius-lg) 0;
    padding: var(--space-lg) var(--space-xl);
    margin: var(--space-2xl) 0;
  }

  .pull-quote p {
    font-size: var(--fs-lg);
    font-style: italic;
    line-height: 1.5;
    color: var(--color-text);
    font-weight: var(--fw-medium);
  }

  /* Byline */
  .article__byline {
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .article__byline-author {
    font-size: var(--fs-base);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }

  .article__byline-editor {
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
  }

  /* Separator */
  .article__separator {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-3xl) 0 var(--space-2xl);
  }

  /* Data note */
  .article__data-note {
    margin-top: 0;
    padding: var(--space-xl);
    background: var(--color-section-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-lg);
  }

  .article__data-note-title {
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }

  .article__data-note-item {
    font-size: var(--fs-xs);
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
  }

  .article__data-note-item:last-child {
    margin-bottom: 0;
  }

  .article__data-note-item strong {
    color: var(--color-text);
  }
</style>
